# SPOTIFY_CLIENT_ID: Client ID from Spotify Developer Dashboard for official Spotify OAuth PKCE / App Remote integration.
SPOTIFY_CLIENT_ID=YOUR_SPOTIFY_CLIENT_ID

# SPOTIFY_API_KEY: Optional Spotify Web API / Developer key configured via AI Studio Secrets or in-app API Manager.
SPOTIFY_API_KEY=YOUR_SPOTIFY_API_KEY

# SOUNDCLOUD_CLIENT_ID: Client ID from SoundCloud Developer Portal for official SoundCloud OAuth PKCE & API integration.
SOUNDCLOUD_CLIENT_ID=YOUR_SOUNDCLOUD_CLIENT_ID

# CUSTOM_API_KEY: Optional API key for custom modular external music/metadata providers.
CUSTOM_API_KEY=YOUR_CUSTOM_API_KEY
